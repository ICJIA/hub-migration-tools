{
  "kind": "collectionType",
  "collectionName": "datasets",
  "info": {
    "singularName": "dataset",
    "pluralName": "datasets",
    "displayName": "Dataset",
    "description": "Downloadable datasets with metadata, variables, and file attachments"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "legacyId": {
      "type": "string",
      "unique": true
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "date": {
      "type": "date"
    },
    "external": {
      "type": "boolean"
    },
    "categories": {
      "type": "json"
    },
    "tags": {
      "type": "json"
    },
    "project": {
      "type": "boolean"
    },
    "sources": {
      "type": "json"
    },
    "unit": {
      "type": "string"
    },
    "timeperiod": {
      "type": "json"
    },
    "description": {
      "type": "text"
    },
    "notes": {
      "type": "json"
    },
    "variables": {
      "type": "json"
    },
    "funding": {
      "type": "string"
    },
    "citation": {
      "type": "string"
    },
    "datafile": {
      "type": "media",
      "allowedTypes": [
        "files"
      ],
      "multiple": false
    },
    "apps": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::app.app",
      "mappedBy": "datasets"
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "mappedBy": "datasets"
    }
  }
}
